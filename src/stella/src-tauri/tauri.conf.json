{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "version": "0.1.0",
  "identifier": "dev.arc.stella",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stella · Arc Workbench",
        "width": 1480,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
